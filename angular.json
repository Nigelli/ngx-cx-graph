          "configurations": {
            "production": {
              "buildTarget": "demo-primeng:build:production"
            },
            "development": {
              "buildTarget": "demo-primeng:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/demo-primeng/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo-primeng/public"
              }
            ],
            "styles": [
              "projects/demo-primeng/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}