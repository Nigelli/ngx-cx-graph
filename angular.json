        }
      },
      "root": "projects/demo-primeng",
      "sourceRoot": "projects/demo-primeng/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/demo-primeng",
