            "browser": "projects/demo-primeng/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/demo-primeng/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
