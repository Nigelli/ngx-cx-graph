                "input": "projects/demo-primeng/public"
              }
            ],
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "projects/demo-primeng/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
