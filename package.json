{
  "name": "ngx-cx-graph-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo-nebular --port 4301",
    "start:nebular": "ng serve demo-nebular --port 4301",
    "start:material": "ng serve demo-material --port 4302",
    "start:primeng": "ng serve demo-primeng --port 4303",
    "build": "ng build",
    "build:lib": "ng build cx-graph",
    "build:demo": "ng build demo-nebular && ng build demo-material && ng build demo-primeng",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test cx-graph --no-watch --no-progress --browsers=ChromeHeadless",
    "release": "ng build cx-graph && cd dist/cx-graph && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@nebular/eva-icons": "^15.0.0",
    "@nebular/theme": "^15.0.0",
    "@primeng/themes": "^19.1.4",
    "eva-icons": "^1.1.3",
    "primeicons": "^8.0.2",
    "primeng": "^19.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.22",
    "@angular/cli": "^19.2.22",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.7.2"
  }
}
